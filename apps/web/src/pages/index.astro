---
// Minimal, sleek marketing landing page for DealBridge CRM.
import Base from "../layouts/Base.astro";
---

<Base title="DealBridge CRM | Minimal Sales & Pipeline Workspace">
  <main class="relative flex min-h-screen flex-col justify-between bg-canvas text-fg px-4 py-8 sm:px-6 lg:px-8">
    {/* Subtle Glow Accent */}
    <div class="pointer-events-none absolute -top-32 left-1/2 -z-10 h-96 w-[600px] -translate-x-1/2 rounded-full bg-indigo-500/10 blur-[100px] dark:bg-indigo-500/15" />

    {/* Top Header */}
    <header class="mx-auto flex w-full max-w-4xl items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-line bg-surface overflow-hidden shadow-xs">
          <img src="/autonex_ai_logo.jpeg" alt="Autonex AI" class="h-full w-full object-cover" />
        </div>
        <span class="text-sm font-bold tracking-tight text-fg">DealBridge <span class="text-fg-subtle font-normal">CRM</span></span>
      </a>

      <div class="flex items-center gap-3">
        <a
          href="/app/login"
          class="text-xs font-semibold text-fg-muted transition-colors hover:text-fg"
        >
          Sign In
        </a>
        <a
          href="/app"
          class="inline-flex h-8 items-center rounded-lg bg-indigo-600 px-3.5 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-indigo-500"
        >
          Open App →
        </a>
      </div>
    </header>

    {/* Hero Content */}
    <section class="mx-auto my-auto max-w-2xl text-center py-12">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-[11px] font-semibold text-indigo-600 dark:text-indigo-400 shadow-xs mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse" />
        Pipeline & Sales Workspace
      </span>

      <h1 class="text-3xl font-extrabold tracking-tight text-fg sm:text-5xl sm:leading-tight">
        The CRM your team <br />
        <span class="text-indigo-600 dark:text-indigo-400">actually keeps open.</span>
      </h1>

      <p class="mt-4 text-sm sm:text-base text-fg-muted leading-relaxed max-w-xl mx-auto">
        Kanban pipelines that move the way your team does. Contacts, deals, Google Calendar meeting sync, and tax invoices in one minimal workspace.
      </p>

      {/* Action Buttons */}
      <div class="mt-8 flex items-center justify-center gap-3">
        <a
          href="/app"
          class="inline-flex h-10 items-center justify-center rounded-xl bg-indigo-600 px-6 text-xs font-semibold text-white shadow-md shadow-indigo-500/20 transition-all hover:bg-indigo-500"
        >
          Launch Workspace
        </a>
        <a
          href="/app/register"
          class="inline-flex h-10 items-center justify-center rounded-xl border border-line bg-surface px-6 text-xs font-semibold text-fg transition-colors hover:bg-surface-hover"
        >
          Create Account
        </a>
      </div>

      {/* Minimal Feature Highlights */}
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-3 text-left">
        <div class="rounded-xl border border-line bg-surface/70 p-3.5 backdrop-blur-xs">
          <div class="text-xs font-bold text-fg">📊 Kanban Pipeline</div>
          <p class="mt-1 text-[11px] text-fg-muted">Drag-and-drop deals with probability & stage velocity.</p>
        </div>
        <div class="rounded-xl border border-line bg-surface/70 p-3.5 backdrop-blur-xs">
          <div class="text-xs font-bold text-fg">📅 Calendar & Slack</div>
          <p class="mt-1 text-[11px] text-fg-muted">Direct Google Meet booking & automated team alerts.</p>
        </div>
        <div class="rounded-xl border border-line bg-surface/70 p-3.5 backdrop-blur-xs">
          <div class="text-xs font-bold text-fg">📄 Quotes & Invoices</div>
          <p class="mt-1 text-[11px] text-fg-muted">1-click conversion from won deals to tax invoices.</p>
        </div>
      </div>
    </section>

    {/* Minimal Footer */}
    <footer class="mx-auto flex w-full max-w-4xl items-center justify-between text-[11px] text-fg-subtle pt-4 border-t border-line/60">
      <span>© 2026 Autonex AI</span>
      <div class="flex gap-4">
        <a href="/app" class="hover:text-fg transition">App</a>
        <a href="/app/login" class="hover:text-fg transition">Login</a>
        <a href="/app/register" class="hover:text-fg transition">Register</a>
      </div>
    </footer>
  </main>
</Base>
