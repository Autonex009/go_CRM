# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gocrm_dev?sslmode=disable
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Gateway & Server Options
# -----------------------------------------------------------------------------
GATEWAY_ADDR=:8080
WEB_APP_URL=http://localhost:4321
OIDC_REDIRECT_BASE=http://localhost:8080/api/v1/auth/sso

# -----------------------------------------------------------------------------
# Authentication & JWT
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-dev-secret-key-12345
JWT_ISSUER=go-crm
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# -----------------------------------------------------------------------------
# NATS Event Bus (Optional / Local Dev)
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# OAuth Providers (Optional - Leave blank to disable)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Notification Email (Optional - Leave SMTP_HOST blank to disable)
# -----------------------------------------------------------------------------
# When a deal card moves on the board, everyone in the organization except the
# person who moved it is emailed. With SMTP_HOST or SMTP_FROM empty the
# notification is skipped silently and nothing else changes.
# Port 465 uses implicit TLS; any other port negotiates STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=go-CRM

# -----------------------------------------------------------------------------
# Google Calendar (Optional - needed to book a Meet when scheduling a call)
# -----------------------------------------------------------------------------
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above, but with its own redirect
# URI: signing in and connecting a calendar are separate consents, and Google
# matches the redirect exactly. Register "<base>/google/callback" in the Google
# console and enable the Google Calendar API on the project.
INTEGRATIONS_REDIRECT_BASE=http://localhost:8080/api/v1/integrations
